{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist/web",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://gen-lang-client-0743834205.firebaseapp.com/__/auth/:path*"
    },
    { "source": "/account-deletion", "destination": "/index.html" },
    {
      "source": "/privacy",
      "has": [{ "type": "query", "key": "lang", "value": "en" }],
      "destination": "/privacy-en.html"
    },
    { "source": "/privacy", "destination": "/privacy.html" },
    {
      "source": "/terms",
      "has": [{ "type": "query", "key": "lang", "value": "en" }],
      "destination": "/terms-en.html"
    },
    { "source": "/terms", "destination": "/terms.html" },
    {"source": "/odalar", "has": [{"type": "query", "key": "lang", "value": "en"}], "destination": "/odalar-en.html"},
    {"source": "/odalar", "destination": "/odalar.html"},
    {"source": "/odak-zamanlayici", "has": [{"type": "query", "key": "lang", "value": "en"}], "destination": "/odak-zamanlayici-en.html"},
    {"source": "/odak-zamanlayici", "destination": "/odak-zamanlayici.html"},
    {"source": "/oyunlar", "has": [{"type": "query", "key": "lang", "value": "en"}], "destination": "/oyunlar-en.html"},
    {"source": "/oyunlar", "destination": "/oyunlar.html"},
    { "source": "/healthz", "destination": "/healthz.json" }
  ],
  "headers": [
    {
      "source": "/account-deletion",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
