{
  "expo": {
    "name": "Sanal Kütüphane",
    "slug": "sanal-kutuphane",
    "scheme": "sanalkutuphane",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "userInterfaceStyle": "dark",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "com.metabtw.sanalkutuphane"
    },
    "android": {
      "package": "com.metabtw.sanalkutuphane",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
